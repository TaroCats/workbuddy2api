# ─────────────────────────────────────────────────────────────────────────────
# 栈的环境变量模板
#
# 用法：./scripts/stack.sh init   ← 会把它复制成 .env、自动填好 STACK_DIR
#        并生成一个随机的面板口令。之后按需修改 .env 即可。
#
# 注意：本文件被 .gitignore 的 `.env.*` 规则忽略，是靠 git add -f 强制入库的
#      （和 FORK.md 一样）。真正生效的 .env 永远不会进版本库。
# ─────────────────────────────────────────────────────────────────────────────

# ── 必填：本栈在宿主机上的绝对路径 ───────────────────────────────────────────
# updater 容器要按「同一个绝对路径」挂载本目录，compose 里的 ./auths、./config.json
# 这类相对路径才能被解析成正确的宿主机路径。写错的典型症状是：更新完后容器挂到了
# 空目录上，账号全没了。stack.sh init 会自动填成当前目录，正常情况下不用手改。
STACK_DIR=/opt/workbuddy2api

# ── 通用 ─────────────────────────────────────────────────────────────────────
TZ=Asia/Shanghai

# ── 网关 ─────────────────────────────────────────────────────────────────────
# 镜像由 GitHub Actions 构建推送到 GHCR（见 .github/workflows/build.yml）
WB2API_IMAGE=ghcr.io/tarocats/workbuddy2api:latest
# 7863 绑定到哪个地址。0.0.0.0 = 对外提供 OpenAI 兼容 API；
# 不想直接暴露就改成 127.0.0.1（那样只有反代能访问）。
WB2API_BIND=0.0.0.0

# ── 控制台面板 ───────────────────────────────────────────────────────────────
WBGUI_IMAGE=workbuddy2api-gui:local
WBGUI_REPO=https://github.com/linbeize/workbuddy2api-gui.git
WBGUI_REF=master
WBGUI_USERNAME=admin
# 面板口令不在这里 —— 它由 ./scripts/stack.sh init 随机生成并追加到 .env 末尾的
# WBGUI_PASSWORD= 行（本文件里不会有明文口令，免得被误提交）。想换就直接改 .env 里那一行，
# 然后 ./scripts/stack.sh up 重建面板。
WBGUI_SESSION_TTL=12h
# 高危操作总开关（重启网关、删除账号、恢复配置备份）。
# 保持 false 时这些动作在 UI 上是禁用的 —— 建议先用 false 熟悉面板再打开。
WBGUI_DANGEROUS_OPS=false
# 反代兜底（一般留空）。面板对写操作会做同源校验，候选主机取自 Host 与
# X-Forwarded-Host，而 caddy 默认把两者都透传，所以正常不需要填。
# 只有当你把本栈放到「不转发任何 Host 头」的自建代理后面时，才填对外域名，逗号分隔：
#   WBGUI_ALLOWED_ORIGINS=panel.example.com,10.0.0.5:8787
WBGUI_ALLOWED_ORIGINS=

# ── 面板入口（caddy）────────────────────────────────────────────────────────
# 留空 = 监听 80，用 http://<服务器IP>/ 访问（无 HTTPS）。
# 填域名（如 panel.example.com）= 自动签发并续期 Let's Encrypt 证书；
# 前提是域名已解析到本机、80/443 从公网可达，否则签发会失败。
#
# 留空是安全的：compose 里写的是 ${WGUI_SITE:-:80}，用的是 `:-`（未设置**或为空**都取默认），
# 所以这里留空会变成 :80 交给 caddy。但别把空值**直接**传给 caddy —— 它的
# {$VAR:default} 只在变量「未设置」时才用默认值，空串会让站点块变成无标签块而拒绝启动。
WGUI_SITE=
HTTP_PORT=80
HTTPS_PORT=443

# ── 更新器 ───────────────────────────────────────────────────────────────────
# 更新器自己的镜像名。updater 在「编排自更新」时会重建这个 tag 并派发 helper，
# 所以它必须与 docker-compose.fork.yml 里 updater 服务的 image 完全一致。
UPDATER_IMAGE=workbuddy-stack-updater:local
# 检查间隔（秒）。默认 21600 = 6 小时。
UPDATE_INTERVAL=21600
# 容器启动后多久开始第一轮检查（秒）。留一点余量，避开开机时整体拉起的高峰。
INITIAL_DELAY=30
# 单个服务更新后等待健康检查的上限（秒）。首次重建要拉层，给宽一点。
HEALTH_TIMEOUT=180
# 是否让编排文件本身也自动跟随本仓库（compose / Caddyfile / updater 脚本）。
# 开启后 updater 会定时 git pull，并强制用 compose config 校验新配置，
# 校验不过立刻回退。想完全冻结编排改动就设成 0。
SELF_UPDATE=1
# 要托管的服务与顺序（默认两个都管，逗号换成空格分隔）
SERVICES=wb2api wbgui
